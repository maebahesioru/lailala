--- a/dist/src/parser/classes/comments/CommentThread.js
+++ b/dist/src/parser/classes/comments/CommentThread.js
@@ -33,6 +33,24 @@ export default class CommentThread extends YTNode {
             throw new InnertubeError('Cannot determine if there is a continuation because this comment thread\'s replies have not been loaded');
         return !!this.#continuation;
     }
+
+    /**
+     * [lailala patch] Raw continuation token for the next page, if any.
+     * Upstream only exposes getContinuation(), which holds the state inside the
+     * instance; a stateless HTTP API needs the raw token to page on its own.
+     */
+    get continuation_token() {
+        const item = this.#continuation;
+        if (!item)
+            return null;
+        for (const endpoint of [item.endpoint, item.button?.endpoint]) {
+            const payload = endpoint?.payload;
+            const token = payload?.continuationCommand?.token ?? payload?.token;
+            if (typeof token === 'string' && token.length > 0)
+                return token;
+        }
+        return null;
+    }
     /**
      * Indicates whether this comment thread has prepopulated reply data. If false, you will need to call {@link CommentThread.getReplies} to fetch the initial batch of replies.
